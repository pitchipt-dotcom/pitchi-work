+    private static function metadataRows(string $query): array
+    {
+        $out=[];
+        foreach (glob(dirname(__DIR__).'/config/guideline_metadata/*.json')?:[] as $path) {
+            $m=json_decode(file_get_contents($path),true,512,JSON_THROW_ON_ERROR);
+            self::validateMetadata($m);
+            $row=self::metadataRow($m);
+            $text=mb_strtolower($row['guideline_title'].' '.$row['keywords_json']);
+            $subject=false;
+            foreach(array_merge($m['diseases'],$m['synonyms']) as $term)
+                if(self::contains(mb_strtolower($query),mb_strtolower($term)))$subject=true;
+            if(!$subject)continue;
+            foreach(self::queryConcepts($query) as $concept) {
+                $hit=false;
+                foreach($concept['aliases'] as $term)if(self::contains($text,$term))$hit=true;
+                if(!$hit)continue 2;
+            }
+            $out[]=$row;
+        }
+        return $out;
+    }
+
+    private static function validateMetadata(array $m): void
+    {
+        foreach(['id','title','issuer','edition','official_url','language','terms_status','allowed_scope','ingestion_status','checked_at'] as $k)
+            if(!is_string($m[$k]??null)||trim($m[$k])==='')throw new RuntimeException($k);
+        foreach(['diseases','synonyms','search_terms','gold_ids'] as $k) {
+            if(!is_array($m[$k]??null))throw new RuntimeException($k);
+            foreach($m[$k] as $v)if(!is_string($v)||$v==='')throw new RuntimeException($k);
+        }
+        if(!is_int($m['revision_year']??null)||$m['allowed_scope']!=='metadata_only'||!filter_var($m['official_url'],FILTER_VALIDATE_URL)||parse_url($m['official_url'],PHP_URL_SCHEME)!=='https')throw new RuntimeException('metadata scope/URL');
+    }
+
+    private static function metadataRow(array $m): array
+    {
+        $row=array_fill_keys(['chapter','page_start','page_end','clinical_question','population','phase','setting','intervention','outcome','recommendation','recommendation_strength','evidence_level','ptot_point','section_url'],null);
+        return $row+['id'=>'metadata:'.$m['id'],'guideline_id'=>$m['id'],
+            'guideline_title'=>$m['title'],'section_title'=>$m['title'],'issuing_body'=>$m['issuer'],
+            'publication_year'=>$m['revision_year'],'edition'=>$m['edition'],
+            'source_url'=>$m['official_url'],'verified_at'=>$m['checked_at'],
+            'collection_mode'=>'metadata_only','summary_provenance'=>'bibliographic',
+            'summary'=>'メタデータのみ。公式公開元の資料をご確認ください。',
+            'keywords_json'=>json_encode(array_merge($m['diseases'],$m['synonyms'],$m['search_terms']),JSON_UNESCAPED_UNICODE),
+            'tags_json'=>json_encode($m['diseases'],JSON_UNESCAPED_UNICODE)];
+    }
