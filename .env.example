# Optional local model endpoint configuration.
# Copy this file to .env and fill in only local, non-committed settings.
LLM_HOST=localhost
LLM_PORT=8092
LLM_MODEL=

# Alternatively configure the complete endpoint. The application only accepts
# localhost-style HTTP endpoints for the grounding/QA path.
BOOK_AI_QA_LLM_URL=http://localhost:8092/v1/chat/completions
BOOK_AI_QA_LLM_MODEL=

# Do not put API keys, passwords, tokens, or credentials in this file.
